from io import BytesIO
from pdfrw import PdfReader, PdfWriter, PageMerge
from reportlab.pdfgen import canvas

PAGE_W, PAGE_H = 612, 792

def dot(c, x, y, label=""):
    c.setFillColorRGB(1, 0, 0)
    c.circle(x, y, 3, fill=1)
    c.setFont("Helvetica-Bold", 6)
    c.setFillColorRGB(0, 0, 0.8)
    c.drawString(x + 4, y - 2, label)

buf = BytesIO()
c = canvas.Canvas(buf, pagesize=(PAGE_W, PAGE_H))

# Put a dot wherever you think a field should go
dot(c, 100, 585, "date")
dot(c, 222, 585, "branch")
dot(c, 208, 485, "RP checkbox")
# ...add more as needed

c.save()
buf.seek(0)

# Merge onto the real template
tp = PdfReader("backflow_template.pdf")
op = PdfReader(buf)
pg = tp.pages[0]
PageMerge(pg).add(op.pages[0]).render()

with open("dot_check.pdf", "wb") as f:
    PdfWriter().write(f, tp)
